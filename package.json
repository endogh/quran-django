{
  "name": "quran-django-tailwind",
  "version": "1.0.0",
  "private": true,
  "description": "Tailwind CSS build untuk Quran Kareem (Django)",
  "scripts": {
    "build": "tailwindcss -i ./src/tailwind.css -o ./quran/static/css/tailwind.css --minify",
    "watch": "tailwindcss -i ./src/tailwind.css -o ./quran/static/css/tailwind.css --watch"
  },
  "devDependencies": {
    "@fontsource/amiri": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/lateef": "^5.3.0",
    "@fontsource/noto-naskh-arabic": "^5.3.0",
    "@fontsource/reem-kufi": "^5.3.0",
    "@fontsource/scheherazade-new": "^5.3.0",
    "bootstrap-icons": "^1.11.3",
    "chart.js": "^4.4.1",
    "jquery": "^3.7.1",
    "tailwindcss": "^3.4.17"
  }
}
